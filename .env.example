# Leave everything empty to run the demo: simulated PayPal and offline rules.

# Claude reads customer replies. https://console.anthropic.com
ANTHROPIC_API_KEY=

# PayPal sandbox app. https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: needed only for the webhook at /api/webhooks/paypal.
# Subscribe the webhook to INVOICING.INVOICE.PAID, UPDATED and CANCELLED.
PAYPAL_WEBHOOK_ID=
